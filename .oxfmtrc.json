{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 120,
	"singleQuote": true,
	"semi": true,
	"trailingComma": "all",
	"arrowParens": "always",
	"endOfLine": "lf",
	"insertFinalNewline": true,
	"sortPackageJson": true,
	"ignorePatterns": ["pnpm-lock.yaml", "node_modules/**", "*.tgz"]
}
