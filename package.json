{
	"name": "@local/steer-background-tool",
	"version": "1.0.0",
	"private": true,
	"description": "Backgrounds an in-flight tool call when the user steers, so the message is not blocked behind a long tool.",
	"keywords": [
		"agent",
		"background-jobs",
		"cordis",
		"deepseek-harness",
		"dsh",
		"plugin",
		"steer",
		"tools"
	],
	"homepage": "https://github.com/Enter-tainer/dsh-steer-background-tool#readme",
	"bugs": {
		"url": "https://github.com/Enter-tainer/dsh-steer-background-tool/issues"
	},
	"license": "MIT",
	"author": "Wenzhuo Liu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Enter-tainer/dsh-steer-background-tool.git"
	},
	"files": [
		"index.js",
		"cordis.patch.yml",
		"locale/*.json",
		"icon.svg"
	],
	"type": "module",
	"main": "index.js",
	"exports": {
		".": "./index.js",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "node --test",
		"validate": "node scripts/validate.mjs",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "node scripts/validate.mjs && oxlint && oxfmt --check && node --test"
	},
	"devDependencies": {
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0"
	},
	"engines": {
		"node": ">=20.17.0"
	},
	"packageManager": "pnpm@11.11.0",
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	}
}
